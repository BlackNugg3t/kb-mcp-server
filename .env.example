# Example environment variables for KB MCP Server
# Copy this to .env and fill in your tokens

# KB MCP Server Access Token (for agent authentication)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
KB_AUTH_TOKEN=

# GitHub Personal Access Token (needs repo + issues scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Notion Integration Token
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# Discord Bot Token
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
