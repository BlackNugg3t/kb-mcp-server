# Example environment variables for KB MCP Server
# Copy this to .env and fill in your tokens

# KB MCP Server Access Token (for agent authentication)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
KB_AUTH_TOKEN=

# GitHub Personal Access Token for the KB scanner (needs repo + issues scope).
# NOT named GITHUB_TOKEN on purpose — `gh` CLI treats GITHUB_TOKEN/GH_TOKEN
# env vars as an auth override that beats `gh auth login`, so a script that
# sources this .env (e.g. deploy.sh) would silently hijack its own `gh`
# session with this unrelated token.
KB_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Notion Integration Token
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# Discord Bot Token
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ── Self-hosted GitHub Actions runner (GymBOOST-team/gymboost) ─────────────
# PAT needs Administration: read/write on the target repo (fine-grained) or
# classic `repo` scope. Used ONLY by the runner container to mint/revoke its
# own registration token — never used as a job's GITHUB_TOKEN.
GH_RUNNER_PAT=
GH_RUNNER_REPO_URL=https://github.com/GymBOOST-team/gymboost
GH_RUNNER_NAME=gymboost-runner-01
GH_RUNNER_LABELS=self-hosted,linux,gymboost
# Safety cap on the queue-watcher's burst runners (runner/watch-queue.sh) —
# how many extra EPHEMERAL runners it may spin up at once on top of the
# always-on gh-runner baseline.
GH_RUNNER_MAX_EXTRA=4

# Claude Code OAuth token. deploy.sh pushes this to the target repo's GitHub
# Actions secrets (gh secret set) so existing workflow steps that reference
# secrets.CLAUDE_CODE_OAUTH_TOKEN keep working — GitHub injects it per-job,
# the runner container never reads this value directly.
CLAUDE_CODE_OAUTH_TOKEN=
