{
  "$schema": "./config.schema.json",
  "name": "gymboost-knowledge-base",
  "version": "1.0.0",
  "description": "Multi-source knowledge base MCP server for GymBoost project — periodically scans GitHub, Notion, Discord, and Telegram, indexes findings, and exposes search/query via MCP protocol.",

  "scan_interval_minutes": 30,
  "scan_jitter_seconds": 60,

  "llm": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-20250514",
    "max_turns": 20,
    "permission_mode": "auto"
  },

  "mcp_server": {
    "mode": "stdio",
    "host": "127.0.0.1",
    "port": 9020,
    "description": "GymBoost Knowledge Base — search, query, and retrieve indexed knowledge from all connected sources.",
    "auth_token": "${KB_AUTH_TOKEN}",
    "rate_limit_rescan_seconds": 300
  },

  "services": {
    "github": {
      "enabled": true,
      "priority": 10,
      "check_interval_minutes": 15,
      "description": "GitHub issues, PRs, commits, and discussions from the GymBoost repo",
      "mcp_server": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
        },
        "mode": "proxy",
        "allow": [
          "search_issues",
          "list_issues",
          "get_issue",
          "list_pull_requests",
          "get_pull_request",
          "list_commits",
          "get_commit",
          "search_code",
          "get_file_contents",
          "list_discussions",
          "get_discussion"
        ]
      },
      "repos": [
        "dev-Leone/gymboost-PWA-betaa"
      ],
      "scan_types": ["issues", "pull_requests", "commits"],
      "filters": {
        "issues": {
          "state": "all",
          "since_days": 7,
          "labels": ["bug", "enhancement", "security", "epic", "documentation"]
        },
        "pull_requests": {
          "state": "all",
          "since_days": 7
        },
        "commits": {
          "since_days": 7,
          "branch": "main"
        }
      }
    },

    "notion": {
      "enabled": true,
      "priority": 8,
      "check_interval_minutes": 30,
      "description": "Notion pages and databases for GymBoost PRD and specifications",
      "mcp_server": {
        "command": "npx",
        "args": ["-y", "@notionhq/notion-mcp-server"],
        "env": {
          "NOTION_API_KEY": "${NOTION_API_KEY}"
        },
        "mode": "proxy",
        "allow": [
          "search",
          "get_page",
          "get_block_children",
          "query_database",
          "get_database",
          "list_comments"
        ]
      },
      "databases": [],
      "page_filters": {
        "search_query": "GymBoost",
        "since_days": 7
      }
    },

    "discord": {
      "enabled": true,
      "priority": 6,
      "check_interval_minutes": 60,
      "description": "Discord channels for team discussions and decisions",
      "mcp_server": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-discord"],
        "env": {
          "DISCORD_BOT_TOKEN": "${DISCORD_BOT_TOKEN}"
        },
        "mode": "proxy",
        "allow": [
          "read_messages",
          "search_messages",
          "get_channel",
          "list_channels",
          "list_guilds"
        ]
      },
      "channels": [],
      "message_filters": {
        "since_hours": 168,
        "max_messages_per_channel": 100
      }
    },

    "telegram": {
      "enabled": true,
      "priority": 5,
      "check_interval_minutes": 60,
      "description": "Telegram chats for team coordination",
      "mcp_server": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-telegram"],
        "env": {
          "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}"
        },
        "mode": "proxy",
        "allow": [
          "get_updates",
          "get_messages",
          "get_chat",
          "list_chats"
        ]
      },
      "chats": [],
      "message_filters": {
        "since_hours": 168,
        "max_messages_per_chat": 100
      }
    }
  },

  "storage": {
    "base_path": "./knowledge",
    "index_file": "index.json",
    "memories_dir": "memories",
    "knowledge_dir": "knowledge",
    "artifacts_dir": "artifacts"
  },

  "tags": {
    "taxonomy": [
      "security",
      "architecture",
      "bug",
      "enhancement",
      "documentation",
      "performance",
      "testing",
      "devops",
      "design",
      "api",
      "database",
      "auth",
      "pwa",
      "mobile",
      "ui",
      "decision",
      "roadmap",
      "blocked",
      "epic",
      "question"
    ]
  },

  "logging": {
    "level": "INFO",
    "format": "json",
    "file": "logs/kb-mcp-server.log",
    "debug": false,
    "activity_log_file": "logs/activity.jsonl"
  }
}
